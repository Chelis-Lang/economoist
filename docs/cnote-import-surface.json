  "chelis_pin": "0.17.4",
  "purpose": "Economoist's canon model + invariant surface for C Note. Every proven-tier invariant here is a genuine unqualified SMT green that CALLS the shipped operator (not a guard restatement); the one fuzz_validated invariant is an honest amber in the sampled lane, carrying a tier_upgrade_trigger. C Note vendors this file and the byte-identical release asset economoist-<pkg_version>.invariants.json. See docs/contracts/characterization_contract_v1.md (schema chelis-shell.invariant-surface/1.0).",
  "models": [
    {
      "id": "gordon",
      "kind": "econ.perpetuity_pv",
      "module": "Economoist.Growth",
      "output_fn": "gordon_pv",
      "sig": "(d: f32, r: f32, g: f32) -> f32",
      "params": [
        {
          "name": "d",
          "meaning": "next-period dividend",
          "unit": "currency",
          "domain": {
            "gt": 0.0
          },
          "sweep_default": {
            "min": 0.5,
            "max": 9.5,
            "value": 2.0
          }
        },
        {
          "name": "r",
          "meaning": "required return",
          "unit": "rate",
          "domain": {
            "gt": 0.0,
            "lt": 1.0,
            "rel": {
              "lhs": "r",
              "op": "gt",
              "rhs": "g"
            }
          },
          "sweep_default": {
            "min": 0.02,
            "max": 0.5,
            "value": 0.1
          }
        },
        {
          "name": "g",
          "meaning": "dividend growth rate",
          "unit": "rate",
          "domain": {
            "gte": 0.0,
            "lt": 1.0
          },
          "sweep_default": {
            "min": 0.0,
            "max": 0.4,
            "value": 0.05
          }
        }
      ],
      "salient_dims": [
        "r",
        "g"
      ],
      "output": {
        "meaning": "present value of the growing perpetuity",
        "unit": "currency"
      },
      "sensitivities": [
        {
          "wrt": "r",
          "fn": "gordon_dP_dr_negative_grad",
          "order": 1
        }
      ],
      "defective": false,
      "notes": "Closed-form Gordon growth model P = D/(r-g); dimension-free, so the general-n caveat is not applicable. Held out: convergence of the discounted sum to the closed form (a limit)."
    },
