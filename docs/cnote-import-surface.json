          "lhs": "r",
          "op": "gt",
          "rhs": {
            "input": "g"
          }
        }
      ],
      "controls": {
        "satisfying": {
          "name": "gordon_positive",
          "expected": "passed"
        },
        "violating": {
          "name": "gordon_positive_wrong",
          "expected": "failed",
          "witness_required": true
        }
      },
      "expected_tier_per_pin": {
        "0.14.0": "proven",
        "0.16.1": "proven",
        "0.17.1": "proven",
        "0.17.4": "proven"
