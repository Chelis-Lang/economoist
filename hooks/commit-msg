#!/bin/sh
#
# commit-msg hook: reject commits carrying AI-authorship markers.
#
# Installed locally via:  git config core.hooksPath ./hooks
#
# Kept aligned across the Chelis shell repos so the protection does not
# drift. Rejects Co-Authored-By trailers and "Generated with/by" lines
# that reference an AI tool.

msg_file="$1"

# POSIX sh has no arrays; iterate a newline-separated pattern list.
patterns="
[Cc]o-[Aa]uthored-[Bb]y:.*(claude|anthropic)
[Cc]o-[Aa]uthored-[Bb]y:.*noreply@anthropic\.com
[Aa]uthored-[Bb]y:.*(claude|anthropic)
[Gg]enerated (with|by).*(claude|anthropic)
[Cc]o-[Aa]uthored-[Bb]y:.*(openai|codex|chatgpt|copilot)
[Cc]o-[Aa]uthored-[Bb]y:.*noreply@openai\.com
[Aa]uthored-[Bb]y:.*(openai|codex|chatgpt|copilot)
[Gg]enerated (with|by).*(openai|codex|chatgpt|copilot|gpt-[0-9])
[Cc]o-[Aa]uthored-[Bb]y:.*\b(ai|llm|assistant)\b
[Gg]enerated (with|by).*\b(ai|llm)\b
"

IFS='
'
for pattern in $patterns; do
    [ -z "$pattern" ] && continue
    if grep -qiE "$pattern" "$msg_file"; then
        echo "error: commit message contains a prohibited AI authorship marker." >&2
        echo "       matched pattern: $pattern" >&2
        echo "       remove any Co-Authored-By or Generated-with line referencing an AI tool." >&2
        exit 1
    fi
done

exit 0
